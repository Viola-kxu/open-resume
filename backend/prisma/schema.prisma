generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ParsedResume {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?  // If you implement user authentication later
  
  // Personal Information
  fullName     String?
  email        String?
  phoneNumber  String?
  location     String?
  
  // Professional Summary
  summary      String?  @db.Text
  
  // Work Experience
  workExperiences WorkExperience[]
  
  // Education
  educations Education[]
  
  // Skills
  skills     Skill[]
  
  // Projects
  projects   Project[]
}

model WorkExperience {
  id            String   @id @default(cuid())
  company       String?
  jobTitle      String?
  date          String?
  descriptions  String[]
  parsedResume  ParsedResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId      String
}

model Education {
  id            String   @id @default(cuid())
  school        String?
  degree        String?
  gpa           String?
  date          String?
  descriptions  String[]
  parsedResume  ParsedResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId      String
}

model Skill {
  id           String   @id @default(cuid())
  name         String
  parsedResume ParsedResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId     String
}

model Project {
  id           String   @id @default(cuid())
  project      String?
  date         String?
  descriptions String[]
  parsedResume ParsedResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId     String
} 